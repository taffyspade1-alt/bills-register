<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 故意不声明 INTERNET 权限：应用没有联网能力，截图与账目无法外传。 -->
    <!-- 这一行是防御性的：即使第三方库在合并清单时带进 INTERNET，也强制移除。 -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- 故意不声明 READ/WRITE_EXTERNAL_STORAGE：图片走系统文件选择器，不需要存储权限。 -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="安心记账"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
